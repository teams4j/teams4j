# Read by ktlint (through Spotless) and by most editors. The Java side's line length comes from
# palantir-java-format, which is not configurable; this keeps Kotlin, detekt and any editor on the
# same 120 so the three cannot disagree at the boundary.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
